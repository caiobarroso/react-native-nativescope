# Logs
logs/
# ...menos o código-fonte do módulo de Logs, que a regra acima engoliria
# inteiro (o padrão `logs/` casa em qualquer profundidade da árvore).
!apps/desktop/src/components/logs/
!packages/runtime/src/modules/logs/
# A LP, a documentação e seus assets também são código/marketing versionado.
!apps/site/src/app/modules/logs/
!apps/site/src/app/modules/logs/page.tsx
!apps/site/content/docs/logs/
!apps/site/content/docs/logs/*.mdx
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and generated output
node_modules/
dist/
dist-ssr/
.next/
out/
coverage/
.turbo/
.cache/
*.tsbuildinfo
*.local

# Local environment
.env
.env.*
!.env.example

# Tool state
.expo/
.pnpm-store/
.claude/
test-results/
playwright-report/

# Playground native projects are regenerated by Expo CNG
apps/playground/android/
apps/playground/ios/

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated shim bundle; rebuilt by the package build
apps/cli/metro/shims/runtime-bundle.js

# Internal planning and design material
/docs/
/apps/site/DESIGN_BRIEF.md
/apps/site/DESIGN_PROMPT.md
